linters: linters_with_defaults(
    trailing_blank_lines_linter = NULL,
    object_name_linter = NULL,
    indentation_linter = NULL,
    pipe_consistency_linter = pipe_consistency_linter(pipe = "%>%")
  )
exclusions: list(
    "R/RcppExports.R",
    "R/zzz.R",
    "data/gtxplus1day.rda",
    "vignettes/detect-nonwear.html",
    "vignettes/detect-nonwear.R",
    "vignettes/detect-sleep.html",
    "vignettes/detect-sleep.R"
  )
